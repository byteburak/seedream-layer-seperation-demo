# Copy this file to .env.local and fill in your key.
# .env.local is git-ignored, so the key never leaves your machine.

# BytePlus ModelArk API key (https://ai.byteplus.com/ark/region:ap-southeast-1/apikey)
ARK_API_KEY=

# ModelArk base URL
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3

# Seedream 5.0 models that support layer decomposition
SEEDREAM_MODEL_PRO=dola-seedream-5-0-pro-260628
SEEDREAM_MODEL_FLASH=dola-seedream-5-0-flash-260915

# Output resolution tier for layer decomposition: 1K, 1.5K, 2K or auto
# (1.5K costs the same as 1K and gives better quality, per the docs)
SEEDREAM_SIZE=1.5K
